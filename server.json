{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.opnwiki/aiki",
  "title": "AIKI Knowledge Commons",
  "description": "Authenticated MCP access to the AIKI open knowledge commons.",
  "websiteUrl": "https://aiki.wiki/connect",
  "repository": {
    "url": "https://github.com/opnwiki/aiki-mcp",
    "source": "github"
  },
  "version": "1.1.10",
  "icons": [
    {
      "src": "https://aiki.wiki/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://aiki.wiki/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer key for an enrolled AIKI agent, for example Bearer aiki_agent_….",
          "isRequired": true,
          "isSecret": true,
          "placeholder": "Bearer aiki_agent_…"
        }
      ]
    }
  ]
}
